#!/bin/bash


CHECK_PATH="/home"

echo
echo "[점검 기준]"
echo "양호 : 소유자가 존재하지 않는 파일 및 디렉터리가 존재하지 않는 경우"
echo "취약 : 소유자가 존재하지 않는 파일 및 디렉터리가 존재하는 경우"

echo
echo "[점검 대상]"
echo "$CHECK_PATH"

echo
echo "[점검 결과]"

RESULT=$(find "$CHECK_PATH" \( -nouser -o -nogroup \) -print 2>/dev/null)

if [ -z "$RESULT" ]; then
    echo "양호"
    echo "소유자가 존재하지 않는 파일 및 디렉터리가 존재하지 않습니다."
else
    echo "취약"
    echo "소유자가 존재하지 않는 파일 및 디렉터리가 존재합니다."
    echo
    echo "[발견된 파일 및 디렉터리]"
    echo "$RESULT"
fi

echo
echo "======================================"
echo " 점검 완료"
echo "======================================"
